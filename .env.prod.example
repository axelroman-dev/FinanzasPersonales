# ═══════════════════════════════════════════════════════════
# Variables de entorno para PRODUCCIÓN
# Copia este archivo a .env y completa los valores:
#   cp .env.prod.example .env
#   nano .env
# ═══════════════════════════════════════════════════════════

# ── Ruta base donde vive la data persistente del servidor ──
# El volumen de Postgres se guarda en ${DATA_PATH}/finanzas/postgres
DATA_PATH=/data

# ── Password de PostgreSQL ──
# CAMBIAR antes de desplegar. Usar password fuerte.
DB_PASSWORD=CAMBIAR_ESTE_PASSWORD

# ── NextAuth: clave secreta para firmar JWTs ──
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=CAMBIAR_CON_OPENSSL_RAND_BASE64_32

# ── URL pública de la app ──
# Con un reverse proxy (nginx, Caddy, Cloudflare Tunnel, etc.) en la red
# "proxy", debe ser el dominio público de la app:
#   https://finanzas.mi-dominio.com
NEXTAUTH_URL=https://finanzas.mi-dominio.com

# ── Contraseña del admin del sistema (admin@finanzas.local) ──
# Obligatoria, mínimo 12 caracteres. El .env es la fuente de verdad: para
# cambiarla, edítala aquí y reinicia el servidor.
ADMIN_PASSWORD=

# ── Zona horaria del servidor (opcional) ──
# Define cuándo empieza cada mes (balance, suscripciones, reportes) y la hora
# con que se muestran los movimientos. Por defecto: America/Mexico_City.
# TZ=America/Mexico_City

# ── Adjuntos: fotos y PDF de recibos (opcional) ──
# Clave para cifrar los archivos en disco. Sin ella los adjuntos están
# desactivados. Generar con: openssl rand -base64 32
# ⚠️ Guárdala junto a tus respaldos: SIN ESTA CLAVE LOS ADJUNTOS NO SE PUEDEN
# RECUPERAR. Un respaldo completo es: base de datos + carpeta uploads + clave.
ATTACHMENTS_KEY=

# ── Correo (opcional) ──
# Para recuperar contraseñas y avisos de seguridad. Sin SMTP_HOST el correo
# está desactivado. Con Hostinger:
#   SMTP_PORT=465 usa SSL; 587 usa STARTTLS
# Para que los correos no lleguen a spam, el dominio necesita registros SPF,
# DKIM y DMARC (en Hostinger: Correos → tu dominio → Autenticación/DNS).
# Prueba la configuración en Admin → Configuración → «Enviar correo de prueba».
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=finanzas@tudominio.com
# SMTP_PASSWORD=
# MAIL_FROM="Finanzas <finanzas@tudominio.com>"
