# ═══════════════════════════════════════════════════════════
# Variables de entorno para PRODUCCIÓN (homelab)
# Copia este archivo a .env y completa los valores:
#   cp .env.prod.example .env
#   nano .env
# ═══════════════════════════════════════════════════════════

# ── Puerto donde se expone la app Next.js ──
APP_PORT=3000

# ── Puerto PostgreSQL (interno siempre es 5432) ──
DB_PORT=5432

# ── Password de PostgreSQL ──
# CAMBIAR antes de desplegar. Usar password fuerte.
DB_PASSWORD=CAMBIAR_ESTE_PASSWORD

# ── NextAuth: clave secreta para firmar JWTs ──
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=CAMBIAR_CON_OPENSSL_RAND_BASE64_32

# ── URL pública de la app ──
# En homelab suele ser algo como:
#   http://192.168.1.100:3000
#   https://finanzas.mi-dominio.com (si usás reverse proxy)
NEXTAUTH_URL=http://localhost:3000

# ── Credenciales del admin inicial (solo se usan en el seed) ──
# ⚠️ Cambiar inmediatamente después del primer login
ADMIN_EMAIL=admin@finanzas.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador
