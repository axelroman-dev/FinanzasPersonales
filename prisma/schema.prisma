generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  DEBIT
  CREDIT
  SAVINGS
  VOUCHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryKind {
  INCOME
  EXPENSE
  // Categorías del sistema (ver src/lib/internal-categories.ts): no se editan
  // ni se eligen al capturar, y no cuentan como ingreso o gasto en reportes
  INTERNAL
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  // null = invitación pendiente: el usuario aún no crea su contraseña y no
  // puede iniciar sesión (ver src/app/invite)
  passwordHash        String?
  name                String
  role                Role      @default(USER)
  isActive            Boolean   @default(true)
  // TRUE cuando el usuario fue creado por un admin con contraseña temporal.
  // Debe cambiarla antes de poder navegar a otras páginas.
  mustChangePassword  Boolean   @default(false)
  // Último cambio o restablecimiento de contraseña: las sesiones iniciadas
  // antes dejan de valer (ver getCurrentUser en src/lib/auth.ts)
  passwordChangedAt   DateTime?
  // Los totales se muestran en la principal; las cuentas solo pueden usar la
  // principal o una secundaria (ver src/lib/currencies.ts)
  primaryCurrency     String    @default("MXN")
  secondaryCurrencies String[]  @default([])
  // De dónde salen los tipos de cambio (ver src/lib/rate-providers.ts)
  ratesProvider       String    @default("ECB")
  // Solo CUSTOM: URL que devuelve { rates: { USD: 0.054, ... } }
  ratesProviderUrl    String?
  // Solo BANXICO: token del SIE; nunca se manda al navegador ni se exporta
  banxicoToken        String?
  // Solo MANUAL: { base: "MXN", rates: { USD: 18.5 } } = 1 USD vale 18.5 MXN
  manualRates         Json?
  manualRatesAt       DateTime?
  // null = cuenta nueva: debe pasar por la configuración inicial (/welcome)
  onboardedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts      Account[]
  transactions  Transaction[]
  attachments   Attachment[]
  subscriptions Subscription[]
  categories    Category[]
  configUpdates AppConfig[]    @relation("ConfigUpdater")
  authTokens    AuthToken[]

  @@index([email])
}

enum AuthTokenType {
  PASSWORD_RESET
  INVITE
}

// Enlace de un solo uso enviado por correo (ver src/lib/auth-tokens.ts). Solo
// se guarda el SHA-256 del token; el token en claro va únicamente en el enlace.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AppConfig {
  id                String   @id @default("singleton")
  allowRegistration Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  updatedById       String?
  updatedBy         User?    @relation("ConfigUpdater", fields: [updatedById], references: [id])
}

// Caché global de tipos de cambio por proveedor (ver src/lib/exchange-rates.ts):
// 1 base = rate quote
model ExchangeRate {
  // ECB, BANXICO, ... o CUSTOM:<hash de la URL>
  provider  String
  base      String
  quote     String
  rate      Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime

  @@id([provider, base, quote])
}

model Account {
  id               String      @id @default(cuid())
  userId           String
  name             String
  type             AccountType
  balance          Decimal     @default(0) @db.Decimal(14, 2)
  currency         String      @default("MXN")
  includeInBalance Boolean     @default(true)

  // Solo para CREDIT
  creditLimit Decimal? @db.Decimal(14, 2)
  cutoffDay   Int? // día del mes (1-31)
  paymentDay  Int? // día del mes (1-31)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]  @relation("AccountTransactions")
  transferTransactions Transaction[]  @relation("TransferAccount")
  subscriptions        Subscription[]

  @@index([userId])
  @@index([type])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  date        DateTime
  description String
  category    String?
  categoryId  String?

  accountId         String
  transferAccountId String?

  isMsi           Boolean  @default(false)
  msiParentId     String?
  msiTotalAmount  Decimal? @db.Decimal(14, 2)
  msiInstallments Int? // total de mensualidades

  subscriptionId String?

  // Cobro de suscripción convertido de otra moneda: el monto original (p. ej.
  // 20 USD) y la tasa usada; `amount` va en la moneda de la cuenta
  originalAmount   Decimal? @db.Decimal(14, 2)
  originalCurrency String?
  exchangeRate     Decimal? @db.Decimal(18, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account       @relation("AccountTransactions", fields: [accountId], references: [id])
  transferAccount Account?      @relation("TransferAccount", fields: [transferAccountId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  categoryRef     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attachments     Attachment[]

  @@index([userId])
  @@index([accountId])
  @@index([date])
  @@index([msiParentId])
  @@index([subscriptionId])
  @@index([categoryId])
}

// Cada cuánto se cobra una suscripción
enum SubscriptionFrequency {
  MONTHLY
  YEARLY
}

model Subscription {
  id           String                @id @default(cuid())
  userId       String
  name         String
  amount       Decimal               @db.Decimal(14, 2)
  // Moneda del monto. Si no es la de la cuenta, cada cobro se convierte con
  // el tipo de cambio de ese día (ver src/lib/subscription-charges.ts)
  currency     String
  billingDay   Int // día del mes
  frequency    SubscriptionFrequency @default(MONTHLY)
  billingMonth Int? // 1-12, solo en las anuales
  // Próximo cobro por registrar (ver src/lib/subscription-charges.ts). null =
  // se calcula desde hoy, sin cobrar fechas pasadas
  nextChargeAt DateTime?
  categoryId   String?
  isActive     Boolean               @default(true)
  accountId    String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@index([isActive])
  @@index([categoryId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  parentId  String? // null = categoría raíz
  kind      CategoryKind @default(EXPENSE)
  color     String? // hex, ej. "#10b981"
  icon      String? // nombre de icono lucide
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Category[]     @relation("CategoryTree")
  transactions  Transaction[]
  subscriptions Subscription[]

  @@unique([userId, name, parentId])
  @@index([userId])
  @@index([parentId])
}

// Recibo u otro archivo adjunto a un movimiento. Los bytes viven cifrados en
// el almacenamiento (ver src/lib/attachments.ts), no en la base de datos.
model Attachment {
  id            String   @id @default(cuid())
  userId        String
  transactionId String
  // Solo para mostrar; nunca se usa como ruta
  originalName  String
  // Detectado por el servidor, no el que manda el navegador
  mimeType      String
  // Bytes del archivo ya procesado, sin cifrar
  size          Int
  // "<userId>/<uuid>", generada por el servidor
  storageKey    String   @unique
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
}

// Registro público esperando que se confirme el correo con un código (ver
// src/lib/registration.ts). La cuenta (User) se crea hasta escribir el código;
// así no quedan cuentas a medias con correos ajenos.
model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique // en minúsculas
  name         String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0)
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())
}
