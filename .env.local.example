# ═══════════════════════════════════════════════════════════
# Variables de entorno para DESARROLLO local
# Copia este archivo a .env y completa los valores:
#   cp .env.local.example .env
#   npm run db:up   # levanta Postgres (docker-compose.dev.yml)
#   npm run dev
# ═══════════════════════════════════════════════════════════

# ── Puerto donde se expone la app Next.js ──
APP_PORT=3000

# ── DATABASE_URL para desarrollo local (npm run dev) ──
# Apunta a la DB de docker-compose.dev.yml (npm run db:up).
# En producción esta variable la arma docker-compose.yml automáticamente.
DATABASE_URL=postgresql://finanzas:finanzas@localhost:5433/finanzas?schema=public

# ── NextAuth: clave secreta para firmar JWTs ──
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=CAMBIAR_CON_OPENSSL_RAND_BASE64_32

# ── URL pública de la app ──
# En un servidor propio suele ser algo como:
#   http://192.168.1.100:3000
#   https://finanzas.mi-dominio.com (si usás reverse proxy)
NEXTAUTH_URL=http://localhost:3000

# ── Credenciales del admin inicial (solo se usan en el seed) ──
# ⚠️ Cambiar inmediatamente después del primer login
ADMIN_EMAIL=admin@finanzas.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador
